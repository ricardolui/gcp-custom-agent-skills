# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials:
#   cp .env.example .env
#
# IMPORTANT:
# - The .env file is strictly ignored by .gitignore and will never be committed.
# - AI Agents and scripts MUST check/source .env before executing commands.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Looker Instance & Credentials
# ------------------------------------------------------------------------------
LOOKER_BASE_URL="https://<YOUR_LOOKER_INSTANCE>.looker.app"
LOOKER_CLIENT_ID="<YOUR_LOOKER_CLIENT_ID>"
LOOKER_CLIENT_SECRET="<YOUR_LOOKER_CLIENT_SECRET>"

# Looker Python SDK format
LOOKERSDK_BASE_URL="https://<YOUR_LOOKER_INSTANCE>.looker.app"
LOOKERSDK_CLIENT_ID="<YOUR_LOOKER_CLIENT_ID>"
LOOKERSDK_CLIENT_SECRET="<YOUR_LOOKER_CLIENT_SECRET>"

# ------------------------------------------------------------------------------
# 2. Google Cloud Profile & Project Configuration
# ------------------------------------------------------------------------------
CLOUDSDK_ACTIVE_CONFIG_NAME="default"
GCP_DEFAULT_ACCOUNT="user@example.com"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# ------------------------------------------------------------------------------
# 3. BigQuery & Dataform Configuration
# ------------------------------------------------------------------------------
BIGQUERY_DATASET_ID="your_dataset"
BIGQUERY_LOCATION="US"
DATAFORM_REPOSITORY_ID="your-dataform-repo"

# ------------------------------------------------------------------------------
# 4. Gemini Enterprise & Discovery Engine (A2A / OAuth)
# ------------------------------------------------------------------------------
GEMINI_ENTERPRISE_HOST_PROJECT="your-gemini-enterprise-project"
GEMINI_ENTERPRISE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"

